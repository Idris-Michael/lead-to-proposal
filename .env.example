# Copy to .env. Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me-webhook-secret
OPERATOR_TOKEN=change-me-operator-token-at-least-24-chars

# Model: offline (no credentials, keyword rules), proxy (containers -> host LLM proxy), claude_cli (host only)
LLM_MODE=offline
LLM_PROXY_URL=http://host.docker.internal:8090
LLM_PROXY_TOKEN=change-me-proxy-token-at-least-24-chars
QUALIFY_MODEL=claude-haiku-5-5
DRAFT_MODEL=claude-sonnet-5-5

# HubSpot: mock (in-process fake) or live (developer test account private app token)
HUBSPOT_MODE=mock
HUBSPOT_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_FAKE_429_RATIO=0.0

# Approvals: local (operator console) or gateway (agent-approval-gateway)
APPROVAL_MODE=local
GATEWAY_URL=http://host.docker.internal:8787
GATEWAY_AGENT_KEY=
GATEWAY_CALLBACK_SECRET=

RATE_LIMIT_PER_MINUTE=60

# Host port for the API and console
API_PORT=8080
